<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Target: Jeskola Buzz 1503, 32-bit. Buzz hosts managed machines on .NET Framework,
    hence net48 + x86. Only the dll is produced (no .pdb, no .deps.json) and deployed
    to the Buzz gear folder.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Pedal Spectral.NET</AssemblyName>
    <RootNamespace>PedalSpectral</RootNamespace>
    <Version>1.5.1</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>
    <BuzzDir Condition="'$(BuzzDir)' == ''">C:\Program Files (x86)\Jeskola\Buzz</BuzzDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: lets the SDK build net48 without the Developer Pack installed.
         PrivateAssets=all, so nothing extra is deployed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF, referenced explicitly rather than via UseWPF: on .NET Framework these are
         ordinary framework assemblies, and there is no XAML to compile. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />

    <!-- Buzz's own SDK assemblies: resolved from the Buzz install, never copied. -->
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Common">
      <HintPath>$(BuzzDir)\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToBuzz" AfterTargets="Build">
    <Message Text="Deploying $(TargetFileName) -> $(BuzzDir)\Gear\Effects\" Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BuzzDir)\Gear\Effects\"
          ContinueOnError="true" />

    <!-- Preset bundle: same base name as the dll, next to it. Generated by
         tools/make_presets.py; warn rather than fail if it is missing. -->
    <PropertyGroup>
      <PresetFile>$(MSBuildProjectDirectory)\$(AssemblyName).prs.xml</PresetFile>
    </PropertyGroup>
    <Copy Condition="Exists('$(PresetFile)')"
          SourceFiles="$(PresetFile)"
          DestinationFolder="$(BuzzDir)\Gear\Effects\"
          ContinueOnError="true" />
    <Warning Condition="!Exists('$(PresetFile)')"
             Text="Preset bundle not found: $(PresetFile). Run tools/make_presets.py." />
  </Target>

</Project>
